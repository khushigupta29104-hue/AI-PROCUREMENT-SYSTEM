{
  "_comment": "Exact field -> source mapping per proposal type, confirmed against the uploaded *_Field_Mapping_Filled.pdf sample-value files. If a value cannot be found in its source, the field is filled with 'NA' and surfaced under 'missing_fields' for the user to complete manually in the editable preview.",

  "source_types": {
    "user_input": "Value typed directly by the user on the Proposal Generator page.",
    "spr": "Retrieved from documents in knowledge_base/spr/.",
    "registration": "Retrieved from documents in knowledge_base/registration/.",
    "purchase_order": "Retrieved from documents in knowledge_base/purchase_order/.",
    "tender": "Retrieved from documents in knowledge_base/tender/.",
    "vendor": "Retrieved from documents in knowledge_base/vendor/ (vendor-submitted Proposal/Quotation/Technical documents).",
    "ai_decision": "The LLM (local Ollama model) decides this value based on retrieved context, not copied verbatim from one document.",
    "manual_user": "Always left as NA for the human user to fill in manually - never auto-filled by the AI."
  },

